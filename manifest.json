{
  "manifest_version": 3,
  "name": "Copy Text and Image URLs",
  "description": "Copy selected text and image URLs to clipboard",
  "version": "1.0",
  "permissions": [
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
